{
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/pages/landing-page.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/(accounting-dashboard|admin-dashboard|book-qr|dashboard|dentist-dashboard|forgot-password|landing-page|login|oauth-callback|patient-dashboard|receptionist-dashboard|signup|verify)(\\.html)?",
      "destination": "/pages/$1.html"
    }
  ]
}
